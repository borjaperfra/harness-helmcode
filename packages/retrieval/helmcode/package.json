{
  "name": "@deepseek-ai/dsh-retrieval-helmcode",
  "description": "Recuperacion para Helmcode: nucleo puro (troceador, embedder qwen3-embedding, rerank e indice local) y su cableado como seam ctx.retrieval con las herramientas index_workspace y knowledge_search",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/686f6c61/harness-helmcode.git",
    "directory": "packages/retrieval/helmcode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./chunk": {
      "types": "./lib/types/chunk.d.ts",
      "default": "./lib/types/chunk.js"
    },
    "./embed": {
      "types": "./lib/types/embed.d.ts",
      "default": "./lib/types/embed.js"
    },
    "./errors": {
      "types": "./lib/types/errors.d.ts",
      "default": "./lib/types/errors.js"
    },
    "./http": {
      "types": "./lib/types/http.d.ts",
      "default": "./lib/types/http.js"
    },
    "./rerank": {
      "types": "./lib/types/rerank.d.ts",
      "default": "./lib/types/rerank.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/types/store.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-fs-local": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
