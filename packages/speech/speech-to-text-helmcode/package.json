{
  "name": "@deepseek-ai/dsh-speech-to-text-helmcode",
  "description": "Transcripcion con el whisper de Helmcode: nucleo puro (troceador de WAV, cliente de /v1/audio/transcriptions) y su cableado como proveedor de la interfaz speech-to-text existente",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/686f6c61/harness-helmcode.git",
    "directory": "packages/speech/speech-to-text-helmcode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./chunker": {
      "types": "./lib/types/chunker.d.ts",
      "default": "./lib/types/chunker.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./errors": {
      "types": "./lib/types/errors.d.ts",
      "default": "./lib/types/errors.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*",
    "@deepseek-ai/dsh-experimental-speech-to-text": "workspace:*"
  }
}
