{
  "name": "@deepseek-ai/dsh-compliance-evidence",
  "description": "Generates the honest egress and residency evidence inventory for a composed configuration dump: what the composition declares, what the provider catalog states, what the residency guard vetoes, what it does not cover, and what a customer deployment must supply",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/686f6c61/harness-helmcode.git",
    "directory": "packages/host/compliance-evidence"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-compliance-evidence": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/cli.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:*"
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "vitest": "^4.1.8"
  }
}
